{
  "name": "ants",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A top-down 2D ant colony simulator with player-driven behavior manipulation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "validate": "npm run typecheck && npm run test && vite build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
